{
  "info": {
    "_postman_id": "b7d12f18-a621-4d33-87bb-e08a6e87f191",
    "name": "Local CI/CD Demo - Microservices & 300ms APIs",
    "description": "Comprehensive Postman collection for the Local CI/CD Demo service, featuring health checks and four high-complexity microservice endpoints with calibrated ~300ms response latencies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Get Application Info & Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Returns application version, service status, and available API endpoint catalog."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status is running\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"running\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health Check Probe",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Lightweight health probe endpoint used by Docker health checks and Jenkins deployment verification."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Health status is UP\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Analytics & Telemetry Engine (~300ms)",
      "item": [
        {
          "name": "Aggregate Metrics (Synthetic 1000-Point Dataset)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/aggregate?windowSize=10&zThreshold=2.5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "aggregate"],
              "query": [
                {
                  "key": "windowSize",
                  "value": "10",
                  "description": "Moving average window size"
                },
                {
                  "key": "zThreshold",
                  "value": "2.5",
                  "description": "Z-score anomaly threshold"
                }
              ]
            },
            "description": "Runs statistical distributions, exact percentiles (p10-p99), 10-bucket histogram, moving averages, and Z-score anomaly detection over 1,000 synthetic metrics data points."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is around 300ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.at.least(290);",
                  "});",
                  "pm.test(\"Response contains summary and percentiles\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.summary.totalDataPoints).to.eql(1000);",
                  "    pm.expect(json.percentiles).to.have.property(\"p50\");",
                  "    pm.expect(json.percentiles).to.have.property(\"p99\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Aggregate Metrics (Custom Dataset Payload)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"windowSize\": 5,\n  \"zThreshold\": 2.0,\n  \"dataset\": [\n    102.5, 98.2, 105.1, 99.8, 103.4, 101.2, 110.5, 95.3, 104.8, 102.1,\n    106.3, 97.4, 101.9, 103.8, 100.5, 104.2, 185.0, 99.1, 102.7, 103.5\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/aggregate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "aggregate"]
            },
            "description": "Submits a custom array of metric observations to compute percentiles, moving averages, and detect anomalies (e.g. the 185.0 spike)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is around 300ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.at.least(290);",
                  "});",
                  "pm.test(\"Detected spike anomaly\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.summary.anomalyCount).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
