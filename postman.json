              "raw": "{\n  \"transaction\": {\n    \"transactionId\": \"tx_custom_77192\",\n    \"userId\": \"usr_fin_982\",\n    \"amount\": 6400.00,\n    \"currency\": \"USD\",\n    \"merchant\": {\n      \"id\": \"mch_luxury_watches\",\n      \"category\": \"wire_transfer\",\n      \"riskRating\": \"HIGH\"\n    },\n    \"card\": {\n      \"bin\": \"424242\",\n      \"issuingCountry\": \"US\",\n      \"isCommercial\": true\n    },\n    \"device\": {\n      \"ipAddress\": \"203.0.113.195\",\n      \"ipCountry\": \"SG\",\n      \"isVpnOrProxy\": true,\n      \"isNewDevice\": true\n    },\n    \"velocity\": {\n      \"transactionsLast1h\": 7,\n      \"totalAmountLast24h\": 12500.00,\n      \"failedAttemptsLast24h\": 4\n    },\n    \"userHistorical\": {\n      \"averageTransactionAmount\": 150.00,\n      \"accountAgeDays\": 20,\n      \"chargebackCount\": 0\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/finance/risk-assessment",
