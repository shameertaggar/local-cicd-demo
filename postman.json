          "name": "Batch Verify Signatures (Custom Batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secretKey\": \"company-cluster-auth-secret-key-2026\",\n  \"items\": [\n    {\n      \"id\": \"claim_001\",\n      \"nonce\": \"a4f89d31ec22\",\n      \"payload\": {\n        \"principal\": \"worker-node-alpha\",\n        \"role\": \"ADMIN\",\n        \"resourceId\": \"res_cluster_01\",\n        \"expiresAt\": 1999999999000\n      },\n      \"signature\": \"35dbcf785bc03fb09df073a6e30eb424c585e135cfad00ea13b4ba4ea193f2f8\"\n    },\n    {\n      \"id\": \"claim_002\",\n      \"nonce\": \"c77e98a1bf04\",\n      \"payload\": {\n        \"principal\": \"worker-node-beta\",\n        \"role\": \"OPERATOR\",\n        \"resourceId\": \"res_cluster_02\",\n        \"expiresAt\": 1999999999000\n      },\n      \"signature\": \"invalid_tampered_signature_hex\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/security/batch-verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "security", "batch-verify"]
