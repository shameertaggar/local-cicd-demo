    {
      "name": "3. Security & Cryptographic Verifier (~300ms)",
      "item": [
        {
          "name": "Batch Verify Signatures (Synthetic Batch)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/security/batch-verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "security", "batch-verify"]
            },
            "description": "Runs cryptographic HMAC-SHA256 signature checks, nonce replay detection, and builds a Merkle Tree Root hash across 25 synthetic security claims."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is around 300ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.at.least(290);",
                  "});",
                  "pm.test(\"Valid Merkle Root generated\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.merkleRootHash).to.be.a(\"string\");",
                  "    pm.expect(json.merkleRootHash.length).to.eql(64);",
                  "    pm.expect(json.batchSummary.batchIntegrityPassed).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
